# INACTIVE: outside .github/workflows and not a .yml workflow filename.
# Proposal only. Do not activate until engine changes are reviewed/merged and
# activation is separately authorized. Existing site_checks.yml stays intact.
name: Synthetic boundary (manual proposal)
on:
  workflow_dispatch:
    inputs:
      engine_sha:
        description: Reviewed immutable patientwords-engine commit (40 hex characters)
        type: string
        required: true
permissions:
  contents: read
jobs:
  synthetic-boundary:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Require immutable engine identity
        env:
          ENGINE_SHA: ${{ inputs.engine_sha }}
        run: '[[ "$ENGINE_SHA" =~ ^[0-9a-f]{40}$ ]]'
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          path: patientwords
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262
        with:
          repository: michaeldgreenphd/patientwords-engine
          ref: ${{ inputs.engine_sha }}
          path: patientwords-engine
          filter: blob:none
          sparse-checkout: |
            scripts
            tests
            data
            ops
            docs
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: '3.13'
      - name: Install separate test tools
        working-directory: patientwords-engine
        run: |
          python -m venv /tmp/boundary-tools
          /tmp/boundary-tools/bin/pip install -r scripts/boundary_client/requirements.lock
          /tmp/boundary-tools/bin/python -m playwright install --with-deps chromium
      - name: Existing affected checks and synthetic HTTP/browser slice
        working-directory: patientwords-engine
        run: |
          /tmp/boundary-tools/bin/python -m pytest tests/test_validate_frontend_contract.py tests/test_simulated_schema.py tests/test_check_pages.py tests/test_export_frontend_defaults.py tests/test_urgency_unjoinable.py -q
          /tmp/boundary-tools/bin/python scripts/check_frontend_boundary.py --site ../patientwords --receipt ../boundary-receipt.json
      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        if: ${{ always() }}
        with:
          name: synthetic-boundary-receipt
          path: boundary-receipt.json
          if-no-files-found: error
